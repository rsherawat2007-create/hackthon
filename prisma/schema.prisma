generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CREATOR
  BRAND
}

enum EngagementStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  creatorProfile CreatorProfile?
  brandProfile   BrandProfile?
}

model CreatorProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  headline         String   @default("")
  bio              String   @default("") @db.Text
  location         String   @default("")
  avatarUrl        String   @default("")
  experience       String   @default("")
  experienceYears  Int      @default(0)
  commercialUse    Boolean  @default(true)
  commercialNotes  String   @default("") @db.Text
  workflow         String   @default("") @db.Text
  trustScore       Int      @default(0)
  skills           String[]
  specializations  String[]
  tools            String[]
  aiModels         String[]
  contentTypes     String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  portfolio    Portfolio[]
  shortlists   Shortlist[]
  engagements  Engagement[]
  verification Verification?
}

model BrandProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  companyName String   @default("")
  industry    String   @default("")
  website     String   @default("")
  logoUrl     String   @default("")
  about       String   @default("") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefs      Brief[]
  shortlists  Shortlist[]
  engagements Engagement[]
  searches    SearchHistory[]
}

model Portfolio {
  id            String   @id @default(cuid())
  creatorId     String
  title         String
  description   String   @db.Text
  mediaUrl      String
  thumbnailUrl  String
  contentType   String
  toolsUsed     String[]
  aiModelsUsed  String[]
  skills        String[]
  aspectRatio   String   @default("16:9")
  commercialUse Boolean  @default(true)
  date          DateTime @default(now())
  category      String   @default("")
  workflow      String   @default("") @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model Brief {
  id                 String   @id @default(cuid())
  brandId            String
  title              String
  description        String   @db.Text
  contentType        String   @default("")
  style              String   @default("")
  targetAudience     String   @default("")
  platform           String   @default("")
  aspectRatio        String   @default("16:9")
  duration           String   @default("")
  requiredTools      String[]
  requiredSkills     String[]
  commercialUse      Boolean  @default(true)
  deadline           DateTime?
  budget             String   @default("")
  deliverables       String[]
  creativeDirection  String   @default("") @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  brand       BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
  engagements Engagement[]
}

model Shortlist {
  id        String   @id @default(cuid())
  brandId   String
  creatorId String
  createdAt DateTime @default(now())

  brand   BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([brandId, creatorId])
}

model Engagement {
  id        String            @id @default(cuid())
  brandId   String
  creatorId String
  briefId   String
  status    EngagementStatus  @default(PENDING)
  message   String            @default("") @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  brand   BrandProfile   @relation(fields: [brandId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  brief   Brief          @relation(fields: [briefId], references: [id], onDelete: Cascade)
}

model Verification {
  id                   String   @id @default(cuid())
  creatorId            String   @unique
  toolsVerified        Boolean  @default(false)
  portfolioAdded       Boolean  @default(false)
  workflowDocumented   Boolean  @default(false)
  previousWork         Boolean  @default(false)
  commercialUseInfo    Boolean  @default(false)
  score                Int      @default(0)
  updatedAt            DateTime @updatedAt

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
}

model SearchHistory {
  id        String   @id @default(cuid())
  brandId   String
  query     String
  filters   Json
  createdAt DateTime @default(now())

  brand BrandProfile @relation(fields: [brandId], references: [id], onDelete: Cascade)
}
